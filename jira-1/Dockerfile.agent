# Jenkins agent with Docker CLI (to build/deploy on host Docker)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS dotnet-sdk

FROM jenkins/agent:latest

USER root

# Install ICU libraries required by .NET
RUN apt-get update && apt-get install -y libicu-dev curl && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy .NET SDK from the official image
COPY --from=dotnet-sdk /usr/share/dotnet /usr/share/dotnet
RUN ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet

# Install Docker CLI (static binary - avoids apt repo signing issues)
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.4.1.tgz | tar xz --strip-components=1 -C /usr/local/bin docker/docker

USER jenkins

RUN dotnet --version && docker --version
